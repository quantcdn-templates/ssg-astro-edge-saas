{
  "name": "ssg-astro-edge-saas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A complete workspace dashboard using Quant edge functions, KV and optional Studio content editing",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "quant serve --run 'astro dev --host 127.0.0.1 --port 4321' --proxy http://127.0.0.1:4321 --seed-key 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
    "serve": "quant serve dist --build 'npm run build' --seed-key 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "provision": "node scripts/provision.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "astro": "7.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@quantcdn/edge-kv": "0.1.0",
    "@quantcdn/quant-cli": "file:../quant-cli-wt-serve"
  }
}
