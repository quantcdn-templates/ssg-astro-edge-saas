---
import "../styles/global.css";
const {
  title = "Orbit",
  description = "A calmer home for your projects.",
  app = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="description" content={description} />
    {app && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" /><title>
      {title} · Orbit
    </title>
  </head>
  <body><a class="skip-link" href="#main">Skip to content</a><slot /></body>
</html>
